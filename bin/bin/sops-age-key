#!/usr/bin/env bash
# sops-age-key: each host's sops age identity, the root of trust for the
# secrets encrypted to it in .sops.yaml, lives in 1Password as a Document
# holding the keys.txt file itself: "<host> sops-nix age key (DO NOT DELETE)"
# in the Private vault of the personal account.
#
#   sops-age-key pull   1Password -> key file. Refuses to replace a different key.
#   sops-age-key push   key file -> 1Password. Uploads the file, or verifies
#                       the existing document holds this key; refuses otherwise.
#
# Overrides: SOPS_AGE_1P_HOST (default `hostname -s`), SOPS_AGE_1P_ITEM (the
# whole title), SOPS_AGE_1P_VAULT, SOPS_AGE_1P_ACCOUNT, SOPS_AGE_KEY_FILE
# (default ~/.config/sops/age/keys.txt, where modules/home/options.nix points
# sops-nix). The document is validated as a keys.txt with exactly one age
# secret before anything is written, and the secret travels as a file, never
# in argv.
set -euo pipefail

host="${SOPS_AGE_1P_HOST:-$(hostname -s 2>/dev/null || hostname)}"
item="${SOPS_AGE_1P_ITEM:-$host sops-nix age key (DO NOT DELETE)}"
vault="${SOPS_AGE_1P_VAULT:-Private}"
account="${SOPS_AGE_1P_ACCOUNT:-famfam.1password.com}"
keyfile="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"

die() {
    printf 'sops-age-key: %s\n' "$*" >&2
    exit 1
}
op_() { op --account "$account" "$@"; }
secret_of() { printf '%s\n' "$1" | grep '^AGE-SECRET-KEY-1[A-Z0-9]*$' || true; }
public_of() { printf '%s\n' "$1" | sed -n 's/^# public key: \(age1[a-z0-9]*\)$/\1/p' | head -n 1; }
# A keys.txt: exactly one age secret line and a public-key comment.
validate() {
    local what="$1" content="$2" n
    n="$(printf '%s\n' "$content" | grep -c '^AGE-SECRET-KEY-1' || true)"
    [ "$n" = 1 ] || die "$what does not hold exactly one age secret key (found $n)"
    [ -n "$(public_of "$content")" ] || die "$what has no '# public key:' line"
}
item_exists() { op_ item get "$item" --vault "$vault" >/dev/null 2>&1; }

pull() {
    local doc
    doc="$(op_ document get "$item" --vault "$vault")" ||
        die "cannot fetch '$item' from vault $vault (is op signed in to $account?)"
    validate "'$item'" "$doc"
    if [ -e "$keyfile" ]; then
        if [ "$(secret_of "$(cat "$keyfile")")" = "$(secret_of "$doc")" ]; then
            echo "sops-age-key: $keyfile already holds the key in '$item'"
            return 0
        fi
        die "$keyfile holds a different key; refusing to overwrite it (move it aside first)"
    fi
    (
        umask 077
        mkdir -p "$(dirname "$keyfile")"
        printf '%s\n' "$doc" >"$keyfile.tmp"
    )
    mv -f "$keyfile.tmp" "$keyfile"
    chmod 600 "$keyfile"
    echo "sops-age-key: wrote $keyfile from '$item'"
}

push() {
    local local_doc stored
    [ -f "$keyfile" ] || die "$keyfile not found"
    local_doc="$(cat "$keyfile")"
    validate "$keyfile" "$local_doc"
    if item_exists; then
        stored="$(op_ document get "$item" --vault "$vault")" || die "'$item' exists but cannot be fetched"
        if [ "$(secret_of "$stored")" = "$(secret_of "$local_doc")" ]; then
            echo "sops-age-key: '$item' already holds this key"
            return 0
        fi
        die "'$item' holds a DIFFERENT key; refusing to overwrite it (rename or delete the item first)"
    fi
    op_ document create "$keyfile" --title "$item" --vault "$vault" --file-name keys.txt >/dev/null
    echo "sops-age-key: stored $keyfile as '$item' in vault $vault"
}

case "${1:-}" in
    pull) pull ;;
    push) push ;;
    *)
        printf 'usage: sops-age-key pull|push\n' >&2
        exit 2
        ;;
esac
