#!/usr/bin/env zsh
# zsh shebang is load-bearing: zsh auto-sources ~/.zshenv on start, which
# defines setup_path and runs it. That PATH then becomes tmux's client env
# (seen by run-shell) and, since tmux.conf no longer overrides it, the
# global env too (seen by #() commands). One canonical list.

# Source OPEN_WEATHER_API_KEY etc. for chevron weather in the status bar
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

TMUX=$(command -v tmux)
if [ -z "$TMUX" ]; then
    echo "tmux not found in PATH"
    exit 1
fi

# List sessions with no clients currently attached. Skipping attached
# sessions avoids the "two Ghostty windows mirroring the same panes"
# trap that plain `attach-session` falls into.
detached=$($TMUX list-sessions -F "#{?session_attached,,#{session_name}}" 2>/dev/null | grep -v '^$')

if [ -z "$detached" ]; then
    if $TMUX list-sessions >/dev/null 2>&1; then
        # Sessions exist but all are attached — we're already in tmux in
        # another window. Escape hatch: plain shell instead of a second
        # tmux session (run `tmux` in it if you do want another session).
        [ "$PWD" = "/" ] && cd "$HOME"
        exec zsh -l
    fi
    # No sessions at all — start a fresh one. Fall back to $HOME when
    # Ghostty was launched by launchd (which spawns it with cwd=/).
    startdir="$PWD"
    [ "$startdir" = "/" ] && startdir="$HOME"
    exec $TMUX new-session -c "$startdir"
fi

detached_count=$(printf '%s\n' "$detached" | wc -l | tr -d ' ')

if [ "$detached_count" -eq 1 ]; then
    exec $TMUX attach-session -t "$detached"
fi

# Multiple detached sessions — menu. The list becomes an array so an answer is
# an array index, not a sed expression: `sed -n "${choice}p"` turned anything
# non-numeric into an empty session_name and a confusing attach-session error.
sessions=("${(f)detached}")

echo "Detached tmux sessions:"
echo
printf '%s\n' "${sessions[@]}" | nl -w2 -s'. '
echo

session_name=""
eof=0
while [[ -z $session_name ]]; do
    echo -n "Enter session number to attach (or press Enter for first): "
    if ! read -r choice; then
        # Ctrl-D or an exhausted pipe: there is no second chance to ask.
        eof=1
        echo
    fi

    # Leading zeros stripped so 007 lines up with the plain number nl printed.
    index=0
    [[ -n $choice && $choice != *[!0-9]* ]] && index=$((10#$choice))

    if [[ -z $choice ]]; then
        session_name=${sessions[1]}
    elif (( index >= 1 && index <= ${#sessions} )); then
        session_name=${sessions[index]}
    elif (( ${sessions[(Ie)$choice]} )); then
        # A session name typed out in full works too; a number always means
        # the menu position, as it did before.
        session_name=$choice
    else
        echo "No session \"$choice\" — enter 1-${#sessions}, a session name, or press Enter for ${sessions[1]}."
        (( eof )) && { echo "Nothing selected, not attaching."; exit 1; }
    fi
done

exec $TMUX attach-session -t "$session_name"
