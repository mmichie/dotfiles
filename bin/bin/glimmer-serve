#!/usr/bin/env bash

set -euo pipefail

readonly model="meta-models/Muse-Glimmer-30B-GGUF:Q4_K_M"
context_size="${GLIMMER_CONTEXT_SIZE:-8192}"
batch_size="${GLIMMER_BATCH_SIZE:-512}"
ubatch_size="${GLIMMER_UBATCH_SIZE:-128}"
reasoning_strength="${GLIMMER_REASONING_STRENGTH:-high}"
port="${GLIMMER_PORT:-8080}"

case "$reasoning_strength" in
low | medium | high | xhigh) ;;
*)
	echo "glimmer-serve: GLIMMER_REASONING_STRENGTH must be low, medium, high, or xhigh" >&2
	exit 2
	;;
esac

if ! command -v llama-server >/dev/null 2>&1; then
	echo "glimmer-serve: llama-server is not installed; run 'just switch' in ~/src/dotfiles" >&2
	exit 127
fi

exec llama-server \
	-hf "$model" \
	-a muse-glimmer-30B \
	-ngl 99 \
	-c "$context_size" \
	-b "$batch_size" \
	-ub "$ubatch_size" \
	-np 1 \
	--host 127.0.0.1 \
	--port "$port" \
	--jinja \
	--chat-template-kwargs "{\"reasoning_strength\":\"$reasoning_strength\"}" \
	--temp 1.0 \
	--top-p 0.95 \
	--top-k 64 \
	"$@"
