/*
 * rofi for the vm-aarch64 guest (Mod+R, hosts/vm-aarch64/dwm/config.h):
 * apps, commands and open windows, in the desktop's colours (palette.rasi,
 * from hosts/vm-aarch64/palette.nix). The search field is two blocks like
 * those of tmux's status line and dwm's bar: the mode on the accent, what
 * you type on colour238, each closed by tmux's arrow, as tall as a line of
 * text so the font's arrow fills it. The selected entry is black on the
 * accent, as in dmenu. Below the search, a message: the calculator's result
 * (Mod+equal), or what a menu asks (hosts/vm-aarch64/scripts). The icons
 * are Papirus's. rofi reads this file each time it opens.
 */
configuration {
	modi: "drun,run,window";
	show-icons: true;
	icon-theme: "Papirus-Dark";
	font: "JetBrainsMono Nerd Font Semi-Bold 11.25"; /* st's font */
	display-drun: "apps";
	display-run: "run";
	display-window: "windows";
	drun-display-format: "{name}";
}

@import "palette.rasi"

* {
	background-color: transparent;
	text-color: @bright;
}

window {
	width: 640px;
	background-color: @bar;
	border: 2px;
	border-color: @accent;
	/* as dunst's (configs/dunst/dunstrc) */
	border-radius: 8px;
	padding: 14px;
}

mainbox {
	spacing: 12px;
	children: [ inputbar, message, listview ];
}

inputbar {
	spacing: 0;
	children: [ prompt, textbox-into-entry, entry, textbox-out-of-entry ];
}

prompt {
	background-color: @accent;
	text-color: @onaccent;
	padding: 0 10px;
}

/* tmux's arrow from one block into the next (U+E0B0), the left one's colour
 * pointing right over the right one's. As markup: rofi shows a theme's \u
 * escape as text. */
textbox-into-entry {
	expand: false;
	markup: true;
	str: "&#xe0b0;";
	background-color: @block;
	text-color: @accent;
}

textbox-out-of-entry {
	expand: false;
	markup: true;
	str: "&#xe0b0;";
	text-color: @block;
}

entry {
	background-color: @block;
	text-color: @bright;
	padding: 0 10px;
	placeholder: "type to filter";
	placeholder-color: @text;
}

listview {
	lines: 8;
	spacing: 2px;
	scrollbar: false;
	fixed-height: false;
}

element {
	padding: 5px 10px;
	spacing: 10px;
}

element normal.normal, element alternate.normal {
	background-color: transparent;
	text-color: @text;
}

element selected.normal {
	background-color: @accent;
	text-color: @onaccent;
}

element-icon {
	size: 24px;
	background-color: transparent;
}

element-text {
	background-color: transparent;
	text-color: inherit;
	vertical-align: 0.5;
}

message {
	background-color: @block;
	padding: 4px 10px;
}

textbox {
	text-color: @bright;
}
