# dunst for the vm-aarch64 guest: notifications in the desktop's colours,
# which dunstrc.d/50-palette.conf sets from hosts/vm-aarch64/palette.nix.
# The X session starts dunst (hosts/vm-aarch64/configuration.nix);
# `dunstctl reload` picks up an edit.

[global]
    # st's font, JetBrains Mono SemiBold at 15px
    font = "JetBrainsMono Nerd Font Semi-Bold 11.25"

    # Top right, below dwm's 31px bar, 10px from the screen's edge and from
    # the bar: the gap dwm leaves around windows (gappx).
    origin = top-right
    offset = (10, 41)
    width = 360
    height = (0, 300)
    notification_limit = 5
    gap_size = 10

    padding = 12
    horizontal_padding = 14
    frame_width = 2
    separator_color = frame
    # as rofi's (configs/rofi/config.rasi)
    corner_radius = 8

    markup = full
    # each urgency's own, from the palette's drop-in, puts the app's name in a
    # block before these (hosts/vm-aarch64/palette.nix)
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    progress_bar = true

    icon_theme = "Papirus-Dark"
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 8

# critical: until dismissed
[urgency_critical]
    timeout = 0
