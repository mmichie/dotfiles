[user]
	name = Matt Michie
	email = mmichie@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEUwxYQhqytNcE3C2yjoY67vOZcSDEX+o2kWXBPznRNq

[core]
	excludesfile = ~/.gitignore_global
	pager = delta
	hooksPath = ~/.config/git/hooks

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	syntax-theme = Dracula

[merge]
	conflictstyle = zdiff3

[color]
	branch = on
	diff = on
	interactive = on
	status = on

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	# Verification half of signing: verify-commit and log --show-signature
	# need the signer list; without it every signature is "no principal".
	# Deployed from configs/git/allowed_signers by modules/home/git.nix.
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true
	# Diff below the message in the editor: catches the wrong hunks staged
	# before they are committed. No effect on -m / -F commits.
	verbose = true

[push]
	autoSetupRemote = true
	# --force-with-lease (the pf alias) with no explicit expected value trusts
	# the remote-tracking ref, which any background fetch refreshes; this
	# additionally requires that the remote tip was integrated locally.
	useForceIfIncludes = true
	# submodule.recurse below would otherwise turn push into on-demand
	# recursion, attempting to push the vendored plugin repos upstream.
	recurseSubmodules = no

[pull]
	# `git pull` refuses unless it can fast-forward. The old `pull = pull
	# --ff-only` alias never applied: git ignores aliases named after
	# builtins, so pulls ran with no protection at all.
	ff = only

[rebase]
	# Interactive rebase aborts if a pick line was deleted, instead of
	# silently dropping the commit.
	missingCommitsCheck = error
	# Stacked branches: refs pointing into the rebased range move with it.
	updateRefs = true
	autoSquash = true

[transfer]
	# Verify objects on fetch and clone. An upstream with historical
	# malformed objects trips this; whitelist per message id with
	# fetch.fsck.<id> = ignore rather than switching it off.
	fsckObjects = true

[fetch]
	prune = true
	# Explicit: submodule.recurse would otherwise make every fetch recurse
	# unconditionally into all vendored plugins; on-demand fetches them only
	# when the superproject's recorded commit moved.
	recurseSubmodules = on-demand

[rerere]
	# Reuse recorded conflict resolutions (repeat rebases onto master, an
	# aborted and redone rebase, the same fix cherry-picked to a release
	# branch). autoUpdate stages the replay; git rerere forget <path> undoes
	# a bad recording.
	enabled = true
	autoUpdate = true

[submodule]
	# checkout, pull, reset and switch keep the vendored tmux plugins at
	# their recorded commits; the flake needs them present to evaluate.
	recurse = true

[diff "nodiff"]
	command = /usr/bin/true

[alias]
	# Repo navigation
	root = rev-parse --show-toplevel

	# Branch helpers
	mainbranch = !git symbolic-ref refs/remotes/origin/HEAD | cut -d'/' -f4
	current-branch = symbolic-ref --short HEAD

	# Workflow shortcuts
	a = add --patch
	co = checkout --recurse-submodules
	cb = checkout -b
	ci = commit
	ca = commit --amend
	cm = commit -m
	fixup = commit --amend --no-edit
	d = diff
	di = diff --cached
	s = show
	st = status -sb
	pf = push --force-with-lease

	# Logging
	graph = log --branches --pretty=short --decorate --graph
	# hist, not history: git history is a builtin (as of git 2.55), and git
	# ignores aliases named after builtins, so the old name silently ran
	# the builtin instead of this log.
	hist = log --stat --patch --
	l = log --pretty=oneline --abbrev-commit --max-count=18
	ll = log --pretty=oneline --abbrev-commit
	gl = log --graph --all --decorate --oneline
	gll = log --graph --all --decorate --pretty=format:'%C(yellow)%h%Creset%C(auto)%d%Creset %s %C(white)- %an, %ar%Creset'

	# Search commits
	ack = log --all -p -S

	# Stash with better names
	shelve = stash save
	unshelve = stash pop

	# Remote operations
	fo = fetch origin
	fu = fetch upstream
	po = push origin
	pu = push upstream

	up = merge --ff-only
	rom = rebase origin/master

	# Branch cleanup
	clean-branches = !git remote prune origin && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -d 2>/dev/null || true
	delete-branch = !sh -c 'git push origin :$1 && git branch -D $1' -
	clean-local-branches = !git branch --merged | grep -v '\\*\\|master\\|main' | xargs -n 1 git branch -d 2>/dev/null || true

[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"

[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
    trustExitCode = true

[includeIf "gitdir:~/src/tensor9.com-v2/"]
	path = ~/.gitconfig-prime-local

[includeIf "gitdir:~/src/moab/"]
	path = ~/.gitconfig-kyusu-local

[url "ssh://git@github.com/"]
#	insteadOf = https://github.com/

[url "git@github.com:shiprock/"]
	insteadOf = https://github.com/shiprock/

[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
