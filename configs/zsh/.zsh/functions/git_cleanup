git_cleanup() {
    git fetch --prune || return
    local default_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')
    default_branch=${default_branch:-main}
    # Merged into the *default branch*, not HEAD: run from a feature branch,
    # bare --merged would offer branches merged into it but not into main.
    local merge_ref="HEAD"
    git show-ref --verify -q "refs/remotes/origin/$default_branch" \
        && merge_ref="origin/$default_branch"
    local current_branch=$(git branch --show-current)
    local branch_output
    branch_output=$(git branch --merged "$merge_ref" --format='%(refname:short)') || return
    [[ -n "$branch_output" ]] || { echo "No merged branches to delete."; return; }
    local -a branches delete_branches
    branches=("${(@f)branch_output}")
    local branch
    for branch in "${branches[@]}"; do
        # Exact string comparisons: branch names may legally contain regex
        # metacharacters such as `+`, which made the old grep -E filter fail
        # to protect the default branch.
        [[ "$branch" == "$default_branch" || "$branch" == master \
            || "$branch" == main || "$branch" == "$current_branch" ]] && continue
        delete_branches+=("$branch")
    done
    (( ${#delete_branches} )) || { echo "No merged branches to delete."; return; }
    git branch -d "${delete_branches[@]}"
}
