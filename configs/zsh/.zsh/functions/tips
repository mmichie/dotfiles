# Show a random tip, or every tip for one tool (`tips zsh`).
# Tips live in $SHELL_CONFIG_DIR/data/tips/<tool>.txt, one per line as
# "keys: what they do", split at the first ": "; a line without one prints
# whole. On a terminal they look like chevron's text banner, which the daily
# tip sits under at shell start (90-banner.zsh): tmux's greys and blue
# accent, a "● TIP · tool" heading, and the keys in bold, lined up with the
# card's contents. Elsewhere they print as plain text: the file itself for
# one tool, and "[tool] tip" for the daily one.
tips() {
    emulate -L zsh
    local data_dir="${SHELL_CONFIG_DIR:-$HOME/.zsh}/data/tips"
    local tool title
    local -a lines

    if (( $# )); then
        tool=$1
        if [[ ! -f "$data_dir/$tool.txt" ]]; then
            local -a available=("$data_dir"/*.txt(N:t:r))
            print -r -- "Available tools: ${(j:, :)available}"
            return 1
        fi
        if [[ ! -t 1 ]]; then
            # command cat: shell aliases cat to bat
            command cat "$data_dir/$tool.txt"
            return
        fi
        lines=(${(f)"$(<"$data_dir/$tool.txt")"})
        title=TIPS
    else
        local -a all owner
        local f tip
        for f in "$data_dir"/*.txt(N); do
            for tip in ${(f)"$(<"$f")"}; do
                all+=("$tip")
                owner+=("${f:t:r}")
            done
        done
        (( $#all )) || return
        local pick=$(( RANDOM % $#all + 1 ))
        tool=$owner[pick]
        if [[ ! -t 1 ]]; then
            print -r -- "[$tool] $all[pick]"
            return
        fi
        lines=("$all[pick]")
        title=TIP
    fi

    # tmux.conf's colours, as the banner has them: the accent, the faint
    # separator, labels and descriptions, the keys (bold).
    local accent=$'\e[1;38;5;39m' faint=$'\e[38;5;238m' dim=$'\e[38;5;245m'
    local keyc=$'\e[1;38;5;254m' off=$'\e[0m' none=

    print
    print -r -- " $accent● $title$off$faint · $off$dim$tool$off"

    # The keys in a column as wide as the widest, up to 24.
    local line keys keyw=0 pad
    for line in $lines; do
        [[ $line == *': '* ]] || continue
        keys=${line%%: *}
        (( $#keys > keyw && $#keys <= 24 )) && keyw=$#keys
    done
    for line in $lines; do
        if [[ $line == *': '* ]]; then
            keys=${line%%: *}
            pad=$(( keyw > $#keys ? keyw - $#keys + 2 : 2 ))
            print -r -- "   $keyc$keys$off${(l:pad:: :)none}$dim${line#*: }$off"
        else
            print -r -- "   $dim$line$off"
        fi
    done
    print
}
