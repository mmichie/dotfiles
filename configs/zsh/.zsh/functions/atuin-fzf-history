# ZLE widget: search shell history with fzf. Falls back to `fc` when atuin
# isn't installed. Registered via `zle -N` in lib/50-integrations.zsh; this
# file is loaded on first ^R press.
atuin-fzf-history() {
    # Pick a real clipboard binary for the ctrl-y binding: fzf's
    # execute-silent runs in a non-interactive shell, where the Linux
    # `pbcopy` alias from 40-clipboard.zsh does not exist.
    local copy="cat > /dev/null"   # no backend: ctrl-y degrades to a no-op
    if (( $+commands[pbcopy] )); then
        copy="pbcopy"
    elif (( $+commands[wl-copy] )); then
        copy="wl-copy"
    elif (( $+commands[xclip] )); then
        copy="xclip -selection clipboard -in"
    elif (( $+commands[xsel] )); then
        copy="xsel --clipboard --input"
    fi

    local selected
    # NUL-delimited records preserve multiline commands, including trailing
    # newlines that command substitution would otherwise strip from output.
    # The fallback uses zsh's history array so no event numbers or multiline
    # display formatting from fc can become part of the selected command.
    selected=$(
        setopt pipefail
        {
            if command -v atuin &>/dev/null; then
                atuin search --cmd-only --print0 --limit 10000 2>/dev/null
            else
                zmodload zsh/parameter || return 1
                local event
                for event in ${(Onk)history}; do
                    print -rn -- "${history[$event]}"$'\0'
                done
            fi
        } | fzf --read0 --print0 \
            --height 40% \
            --reverse \
            --tac \
            --no-sort \
            --exact \
            --query="${LBUFFER}" \
            --preview 'printf %s {}' \
            --preview-window down:3:wrap \
            --bind "ctrl-y:execute-silent(printf %s {} | $copy)+abort" \
            --header 'Press CTRL-Y to copy command to clipboard'
    )
    local selection_rc=$?
    selected="${selected%$'\0'}"

    if (( selection_rc == 0 )) && [[ -n "$selected" ]]; then
        BUFFER="$selected"
        CURSOR=${#BUFFER}
        zle redisplay
    fi
    zle reset-prompt
}
