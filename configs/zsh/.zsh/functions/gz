# Compare original and gzipped file size
gz() {
    if [[ ! -f "$1" ]]; then
        echo "Usage: gz <file>" >&2
        return 1
    fi
    local origsize=$(wc -c < "$1")
    local gzipsize=$(gzip -c "$1" | wc -c)
    if (( origsize > 0 )); then
        printf "orig: %d bytes\n" "$origsize"
        printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$(( gzipsize * 100.0 / origsize ))"
    else
        printf "orig: %d bytes\n" "$origsize"
        printf "gzip: %d bytes (n/a)\n" "$gzipsize"
    fi
}
