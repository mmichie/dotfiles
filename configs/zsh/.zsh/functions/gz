# Compare original and gzipped file size
gz() {
    if [[ ! -f "$1" ]]; then
        echo "Usage: gz <file>" >&2
        return 1
    fi
    setopt localoptions pipefail
    local file="$1" origsize gzipsize
    # gzip treats a bare "-" as stdin even after --.
    [[ "$file" == -* ]] && file="./$file"
    origsize=$(wc -c < "$file") || return
    gzipsize=$(gzip -c "$file" | wc -c) || return
    if (( origsize > 0 )); then
        printf "orig: %d bytes\n" "$origsize"
        printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$(( gzipsize * 100.0 / origsize ))"
    else
        printf "orig: %d bytes\n" "$origsize"
        printf "gzip: %d bytes (n/a)\n" "$gzipsize"
    fi
}
