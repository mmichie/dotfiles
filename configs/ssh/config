Include config.local

Host vm
    HostName 172.16.188.128
    User mim
    IdentityFile ~/.ssh/personal.pub

Host wintermute
    HostName 192.168.1.178
    User mim
    IdentityFile ~/.ssh/personal.pub
    ForwardAgent yes

Host claude-dev
    HostName 10.10.2.90
    User mim
    ProxyJump wintermute
    ForwardAgent yes
    IdentityFile ~/.ssh/personal.pub

Host homelab
    HostName 192.168.1.178
    User mim
    ForwardAgent yes
    IdentityFile ~/.ssh/1password-twisted.pub

Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    AddKeysToAgent no
    IdentitiesOnly yes
    # Keys only. With the agent holding every identity there is never a
    # password to type, so a spoofed or compromised host cannot prompt for
    # one. Override per command for a fresh box that has no key yet:
    #   ssh -o PasswordAuthentication=yes host
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    # Host keys for the named hosts above are pinned in known_hosts.pinned
    # (configs/ssh, linked by home-manager). ssh reads every file listed and
    # writes new keys to the first, so accept-new still learns unlisted hosts
    # while a pinned host presenting a different key is refused.
    UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts.pinned
    ServerAliveInterval 60
    ServerAliveCountMax 3
    StrictHostKeyChecking accept-new
    ConnectTimeout 10
    VisualHostKey yes
