+/* one window in the bar's window list, from x and short of end; returns where
+ * it stops. The focused window shows its chips in colour; another shows only
+ * its directory, greyed, and the icon of an agent waiting on you, in its
+ * colour. A window without chips shows its icon and title. */
+int
+drawclient(Monitor *m, Client *c, int x, int end)
+{
+	char buf[sizeof c->chips], *chip, *text, *save = NULL;
+	int sel = c == m->sel, cx = x, iw, tw, waiting, h = bh - 2 * statusvpad;
+	unsigned int i;
+
+	if (!c->chips[0]) {
+		iw = c->icon ? c->icw + ICONSPACING : 0;
+		tw = MIN(TEXTW(c->name) - lrpad, tabmaxw);
+		if (cx + iw + tw > end)
+			tw = end - cx - iw;
+		if (tw <= 0)
+			return cx;
+		drw_setscheme(drw, scheme[sel ? SchemeTitle : SchemeNorm]);
+		drw_text(drw, cx, 0, iw + tw, bh, iw, c->name, 0);
+		if (c->icon)
+			drw_pic(drw, cx, (bh - c->ich) / 2, c->icw, c->ich, c->icon);
+		return cx + iw + tw;
+	}
+	strcpy(buf, c->chips);
+	for (chip = strtok_r(buf, "\t", &save); chip; chip = strtok_r(NULL, "\t", &save)) {
+		if (!(text = strchr(chip, '|')))
+			continue;
+		*text++ = '\0';
+		for (i = 0; i < LENGTH(chipkinds) && strcmp(chip, chipkinds[i].kind); i++);
+		if (i == LENGTH(chipkinds))
+			continue;
+		waiting = !strcmp(chip, "waiting");
+		if (!sel && !waiting && strcmp(chip, "dir"))
+			continue;
+		iw = TEXTW(chipkinds[i].icon);
+		tw = sel || !waiting ? TEXTW(text) : 0;
+		if (cx + iw + tw > end)
+			break;
+		drw_setscheme(drw, sel || waiting ? chipschemes[i] : scheme[SchemeChipDim]);
+		drw_text(drw, cx, statusvpad, iw, h, lrpad / 2, chipkinds[i].icon, 0);
+		if (tw) {
+			drw_setscheme(drw, scheme[sel ? SchemeChip : SchemeChipDim]);
+			drw_text(drw, cx + iw, statusvpad, tw, h, lrpad / 2, text, 0);
+		}
+		cx += iw + tw + 4;
+	}
+	return cx > x ? cx - 4 : cx;
+}
+
+/* every window on the shown desktops in place of the title (barlist), in
+ * the order dwm keeps them, each in a slot buttonpress reads */
+void
+drawclients(Monitor *m, int x, int w)
+{
+	Client *c;
+	int cx = x + lrpad / 2, end = x + w - lrpad / 2;
+	unsigned int tag;
+
+	drw_setscheme(drw, scheme[SchemeNorm]);
+	drw_rect(drw, x, 0, w, bh, 1, 1);
+	for (tag = 0; tag < LENGTH(tags) && !(m->tagset[m->seltags] & 1 << tag); tag++);
+	for (c = m->clients; c; c = c->next) {
+		c->barw = 0;
+		if (!ISVISIBLE(c) || cx >= end)
+			continue;
+		c->barx = cx;
+		cx = drawclient(m, c, cx, end);
+		c->barw = cx - c->barx;
+		/* the focused window underlined in the desktop's colour */
+		if (c == m->sel && c->barw && tag < LENGTH(tags)) {
+			drw_setscheme(drw, tagschemes[tag]);
+			drw_rect(drw, c->barx, bh - ulinestroke, c->barw, ulinestroke, 1, 0);
+		}
+		cx += 16;
+	}
+}
