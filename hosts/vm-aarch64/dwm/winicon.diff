The focused window's icon (_NET_WM_ICON) leads its title in the bar, the
two centred together (centeredwindowname.diff). Of a window's icons dwm
takes the smallest at least ICONSIZE (config.h), else the largest, and
scales it to ICONSIZE: by XRender when it is at most twice that, by Imlib2
when larger, whose filter keeps a big icon legible. Upstream's winicon
patch. It links Xrender and Imlib2 (config.mk), which configuration.nix
adds to dwm's build inputs.

diff --git a/config.mk b/config.mk
index 982dc21..ded37e5 100644
--- a/config.mk
+++ b/config.mk
@@ -23,7 +23,7 @@ FREETYPEINC = /usr/include/freetype2
 
 # includes and libs
 INCS = -I${X11INC} -I${FREETYPEINC}
-LIBS = -L${X11LIB} -lX11 ${XINERAMALIBS} ${FREETYPELIBS}
+LIBS = -L${X11LIB} -lX11 ${XINERAMALIBS} ${FREETYPELIBS} -lXrender -lImlib2
 
 # flags
 CPPFLAGS = -D_DEFAULT_SOURCE -D_BSD_SOURCE -D_XOPEN_SOURCE=700L -DVERSION=\"${VERSION}\" ${XINERAMAFLAGS}
