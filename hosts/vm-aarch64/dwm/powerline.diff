index b0e49fb..cd00d8e 100644
--- a/drw.c
+++ b/drw.c
@@ -250,6 +250,31 @@ drw_rect(Drw *drw, int x, int y, unsigned int w, unsigned int h, int filled, int
 		XDrawRectangle(drw->dpy, drw->drawable, drw->gc, x, y, w - 1, h - 1);
 }
 
+/* A powerline arrow, as a terminal draws the font's glyph in its cell: the
+ * box in the scheme's background, and on it a triangle in the foreground,
+ * pointing right (dir 1) or left (0) with its point at the box's middle.
+ * XRender draws the triangle antialiased (powerline.diff). */
+void
+drw_arrow(Drw *drw, int x, int y, unsigned int w, unsigned int h, int dir)
+{
+	XPointDouble p[3];
+	Picture fill;
+
+	if (!drw || !drw->scheme)
+		return;
+	XSetForeground(drw->dpy, drw->gc, drw->scheme[ColBg].pixel);
+	XFillRectangle(drw->dpy, drw->drawable, drw->gc, x, y, w, h);
+	p[0].x = p[2].x = dir ? x : x + w;
+	p[1].x = dir ? x + w : x;
+	p[0].y = y;
+	p[1].y = y + h / 2.0;
+	p[2].y = y + h;
+	fill = XRenderCreateSolidFill(drw->dpy, &drw->scheme[ColFg].color);
+	XRenderCompositeDoublePoly(drw->dpy, PictOpOver, fill, drw->picture,
+		XRenderFindStandardFormat(drw->dpy, PictStandardA8), 0, 0, 0, 0, p, 3, 0);
+	XRenderFreePicture(drw->dpy, fill);
+}
+
 /* An ARGB picture of src (premultiplied, srcw x srch) at dstw x dsth: scaled
  * by XRender when it is at most twice the size, otherwise by Imlib2, whose
  * filter keeps a large icon legible when shrunk (winicon.diff). */
