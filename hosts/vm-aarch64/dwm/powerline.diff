+/* an arrow between two of the bar's blocks in tmux's look (powerline.diff),
+ * at x, the left block in left's background and the right one in right's:
+ * pointing right, the left one's colour over the right one's, as tmux's
+ * U+E0B0 in #[fg=left,bg=right]; pointing left, the right one's over the
+ * left one's, as its U+E0B2. Returns where it ends. */
+int
+drawarrow(int x, Clr *left, Clr *right, int dir)
+{
+	arrowscheme[ColFg] = (dir ? left : right)[ColBg];
+	arrowscheme[ColBg] = (dir ? right : left)[ColBg];
+	drw_setscheme(drw, arrowscheme);
+	drw_arrow(drw, x, statusvpad, arroww, bh - 2 * statusvpad, dir);
+	return x + arroww;
+}
