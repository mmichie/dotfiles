+/* the focused window's chips in place of its title, drawn like the status
+ * blocks: _DWM_CHIPS holds tab-separated "kind|text" chips, and each is the
+ * kind's icon on its colour (chipkinds in config.h), then the text in
+ * SchemeChip; a kind config.h doesn't know is skipped */
+void
+drawchips(Monitor *m, int x, int w)
+{
+	char buf[sizeof m->sel->chips], *chip, *text, *save = NULL;
+	int cx = x + lrpad / 2, iw, tw, h = bh - 2 * statusvpad;
+	unsigned int i;
+
+	drw_setscheme(drw, scheme[SchemeNorm]);
+	drw_rect(drw, x, 0, w, bh, 1, 1);
+	strcpy(buf, m->sel->chips);
+	for (chip = strtok_r(buf, "\t", &save); chip; chip = strtok_r(NULL, "\t", &save)) {
+		if (!(text = strchr(chip, '|')))
+			continue;
+		*text++ = '\0';
+		for (i = 0; i < LENGTH(chipkinds) && strcmp(chip, chipkinds[i].kind); i++);
+		if (i == LENGTH(chipkinds))
+			continue;
+		iw = TEXTW(chipkinds[i].icon);
+		tw = TEXTW(text);
+		if (cx + iw + tw > x + w)
+			break;
+		drw_setscheme(drw, chipschemes[i]);
+		drw_text(drw, cx, statusvpad, iw, h, lrpad / 2, chipkinds[i].icon, 0);
+		drw_setscheme(drw, scheme[SchemeChip]);
+		drw_text(drw, cx + iw, statusvpad, tw, h, lrpad / 2, text, 0);
+		cx += iw + tw + 10; /* the gap between status blocks */
+	}
+}
+
