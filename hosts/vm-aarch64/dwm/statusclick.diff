+/* a click on a status block (statusclick.diff): its command from
+ * statusactions, run with sh, which gets the block's left and right edges,
+ * the screen's right edge, the bar's bottom and the button as $1 to $5, to
+ * open a dropdown under the block, say */
+void
+statusclick(const Arg *arg)
+{
+	unsigned int i;
+	char l[12], r[12], sr[12], bb[12], b[4];
+
+	if (arg->i < 0 || arg->i >= nstatusblocks)
+		return;
+	for (i = 0; i < LENGTH(statusactions) && strcmp(statusactions[i].block, statusblocks[arg->i].name); i++);
+	if (i == LENGTH(statusactions))
+		return;
+	snprintf(l, sizeof l, "%d", selmon->wx + statusblocks[arg->i].x0);
+	snprintf(r, sizeof r, "%d", selmon->wx + statusblocks[arg->i].x1);
+	snprintf(sr, sizeof sr, "%d", selmon->mx + selmon->mw);
+	snprintf(bb, sizeof bb, "%d", selmon->by + bh);
+	snprintf(b, sizeof b, "%u", statusbutton);
+	spawn(&(Arg){ .v = (const char *[]){ "/bin/sh", "-c", statusactions[i].cmd, "dwm", l, r, sr, bb, b, NULL } });
+}
