+/* The tab bar (tab.diff): a tab for each visible window, its icon and title
+ * in the bar's colours, the selected one bright over an accent underline as
+ * a selected tag is. A tab is as wide as its title, up to tabmaxw (config.h);
+ * when they do not all fit, they share the bar equally. */
+void
+drawtab(Monitor *m)
+{
+	Client *c;
+	int i, n = 0, x = 0, w, iw, total = 0;
+
+	if (!m->tabwin)
+		return;
+	for (c = m->clients; c && n < MAXTABS; c = c->next) {
+		if (!ISVISIBLE(c))
+			continue;
+		w = TEXTW(c->name) + (c->icon ? c->icw + ICONSPACING : 0);
+		m->tab_widths[n] = MIN(w, tabmaxw);
+		total += m->tab_widths[n++];
+	}
+	m->ntabs = n;
+	if (n && total > m->ww)
+		for (i = 0; i < n; i++)
+			m->tab_widths[i] = m->ww / n;
+
+	drw_setscheme(drw, scheme[SchemeNorm]);
+	drw_rect(drw, 0, 0, m->ww, th, 1, 1);
+	for (c = m->clients, i = 0; c && i < n; c = c->next) {
+		if (!ISVISIBLE(c))
+			continue;
+		w = m->tab_widths[i++];
+		iw = c->icon ? c->icw + ICONSPACING : 0;
+		drw_setscheme(drw, scheme[c == m->sel ? SchemeTagSel : SchemeNorm]);
+		drw_text(drw, x, 0, w, th, lrpad / 2 + iw, c->name, 0);
+		if (c->icon)
+			drw_pic(drw, x + lrpad / 2, (th - c->ich) / 2, c->icw, c->ich, c->icon);
+		if (c == m->sel) {
+			drw_setscheme(drw, scheme[SchemeSel]);
+			drw_rect(drw, x + ulinepad, th - ulinestroke, w - 2 * ulinepad, ulinestroke, 1, 1);
+		}
+		x += w;
+	}
+	drw_map(drw, m->tabwin, 0, 0, m->ww, th);
+}
+
+void
+drawtabs(void)
+{
+	Monitor *m;
+
+	for (m = mons; m; m = m->next)
+		drawtab(m);
+}
