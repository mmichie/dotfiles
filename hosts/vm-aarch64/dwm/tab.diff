+/* focus the arg->ui'th visible window, a tab's (tab.diff) */
+void
+focuswin(const Arg *arg)
+{
+	int iwin = arg->ui;
+	Client *c;
+
+	for (c = selmon->clients; c && (iwin || !ISVISIBLE(c)); c = c->next)
+		if (ISVISIBLE(c))
+			--iwin;
+	if (c) {
+		focus(c);
+		restack(selmon);
+	}
+}
