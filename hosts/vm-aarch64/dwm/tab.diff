 void
 updatebarpos(Monitor *m)
 {
+	Client *c;
+	int nvis = 0;
+
 	m->wy = m->my;
 	m->wh = m->mh;
 	if (m->showbar) {
@@ -2129,6 +2242,20 @@ updatebarpos(Monitor *m)
 		m->wy = m->topbar ? m->wy + bh : m->wy;
 	} else
 		m->by = -bh;
+
+	/* the tab bar (tab.diff), in monocle with more than one window
+	 * (showtab_auto) or always */
+	for (c = m->clients; c; c = c->next)
+		if (ISVISIBLE(c))
+			nvis++;
+	if (showtab == showtab_always
+	|| (showtab == showtab_auto && nvis > 1 && m->lt[m->sellt]->arrange == monocle)) {
+		m->wh -= th;
+		m->ty = toptab ? m->wy : m->wy + m->wh;
+		if (toptab)
+			m->wy += th;
+	} else
+		m->ty = -th;
 }
 
