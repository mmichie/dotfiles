The bar's look. It is vertpadbar pixels taller than its font needs
(config.h), and the coloured blocks in the status text (status2d's ^b^) stop
statusvpad pixels short of its top and bottom. dmenu's line is as tall as the
bar: setup() writes the height into dmenuheight, which dmenucmd passes as -h
(dmenu/lineheight.diff). The tags are drawn by state rather than as stock
dwm's accent block and occupancy squares: the selected one in SchemeTagSel
over an underline in the accent (ulinepad, ulinestroke), those with windows
in SchemeNorm, and empty ones dimmed in SchemeVacant. An urgent tag still
swaps its colours. Applies after status2d.diff and centeredwindowname.diff.

--- a/dwm.c
+++ b/dwm.c
@@ -58,7 +58,7 @@
 
 /* enums */
 enum { CurNormal, CurResize, CurMove, CurLast }; /* cursor */
-enum { SchemeNorm, SchemeSel, SchemeTitle }; /* color schemes */
+enum { SchemeNorm, SchemeSel, SchemeTitle, SchemeVacant, SchemeTagSel }; /* color schemes */
 enum { NetSupported, NetWMName, NetWMState, NetWMCheck,
        NetWMFullscreen, NetActiveWindow, NetWMWindowType,
        NetWMWindowTypeDialog, NetClientList, NetLast }; /* EWMH atoms */
@@ -705,7 +705,7 @@ drawbar(Monitor *m)
 	int x, w, tw = 0;
 	int boxs = drw->fonts->h / 9;
 	int boxw = drw->fonts->h / 6 + 2;
-	unsigned int i, occ = 0, urg = 0;
+	unsigned int i, sel, occ = 0, urg = 0;
 	Client *c;
 
 	if (!m->showbar)
@@ -724,12 +724,14 @@ drawbar(Monitor *m)
 	x = 0;
 	for (i = 0; i < LENGTH(tags); i++) {
 		w = TEXTW(tags[i]);
-		drw_setscheme(drw, scheme[m->tagset[m->seltags] & 1 << i ? SchemeSel : SchemeNorm]);
+		sel = m->tagset[m->seltags] & 1 << i;
+		drw_setscheme(drw, scheme[sel ? SchemeTagSel : occ & 1 << i ? SchemeNorm : SchemeVacant]);
 		drw_text(drw, x, 0, w, bh, lrpad / 2, tags[i], urg & 1 << i);
-		if (occ & 1 << i)
-			drw_rect(drw, x + boxs, boxs, boxw, boxw,
-				m == selmon && selmon->sel && selmon->sel->tags & 1 << i,
-				urg & 1 << i);
+		if (sel) {
+			/* the underline, in SchemeSel's background: the accent */
+			drw_setscheme(drw, scheme[SchemeSel]);
+			drw_rect(drw, x + ulinepad, bh - ulinestroke, w - 2 * ulinepad, ulinestroke, 1, 1);
+		}
 		x += w;
 	}
 	w = TEXTW(m->ltsymbol);
@@ -747,7 +749,7 @@ drawbar(Monitor *m)
 			drw_setscheme(drw, scheme[m == selmon ? SchemeTitle : SchemeNorm]);
 			drw_text(drw, x, 0, w, bh, mid, m->sel->name, 0);
 			if (m->sel->isfloating)
-				drw_rect(drw, x + mid - lrpad / 2 + boxs, boxs, boxw, boxw, m->sel->isfixed, 0);
+				drw_rect(drw, x + mid - lrpad / 2 + boxs, vertpadbar / 2 + boxs, boxw, boxw, m->sel->isfixed, 0);
 		} else {
 			drw_setscheme(drw, scheme[SchemeNorm]);
 			drw_rect(drw, x, 0, w, bh, 1, 1);
@@ -820,7 +822,7 @@ drawstatusbar(Monitor *m, int bh, char* stext) {
 
 			text[i] = '\0';
 			w = TEXTW(text) - lrpad;
-			drw_text(drw, x, 0, w, bh, 0, text, 0);
+			drw_text(drw, x, statusvpad, w, bh - 2 * statusvpad, 0, text, 0);
 
 			x += w;
 
@@ -864,7 +866,7 @@ drawstatusbar(Monitor *m, int bh, char* stext) {
 
 	if (!isCode) {
 		w = TEXTW(text) - lrpad;
-		drw_text(drw, x, 0, w, bh, 0, text, 0);
+		drw_text(drw, x, statusvpad, w, bh - 2 * statusvpad, 0, text, 0);
 	}
 
 	drw_setscheme(drw, scheme[SchemeNorm]);
@@ -1688,7 +1690,8 @@ setup(void)
 	if (!drw_fontset_create(drw, fonts, LENGTH(fonts)))
 		die("no fonts could be loaded.");
 	lrpad = drw->fonts->h;
-	bh = drw->fonts->h + 2;
+	bh = drw->fonts->h + 2 + vertpadbar;
+	snprintf(dmenuheight, sizeof dmenuheight, "%d", bh);
 	updategeom();
 	/* init atoms */
 	utf8string = XInternAtom(dpy, "UTF8_STRING", False);
