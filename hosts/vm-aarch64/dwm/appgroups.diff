+/* whether a window publishes a chip of the kind (chips.diff) */
+int
+haschip(Client *c, const char *kind)
+{
+	size_t n = strlen(kind);
+	const char *p = c->chips;
+
+	do
+		if (!strncmp(p, kind, n) && p[n] == '|')
+			return 1;
+	while ((p = strchr(p, '\t')) && *++p);
+	return 0;
+}
+
+/* whether two windows are of one app: the same WM_CLASS instance */
+int
+sameapp(Client *a, Client *b)
+{
+	return a->app[0] && !strcmp(a->app, b->app);
+}
