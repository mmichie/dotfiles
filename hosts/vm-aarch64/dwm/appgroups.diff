+/* a chip kind's icon between arrows, as a selected tag is: an agent waiting
+ * on you in a window that is not focused. Returns where it ends. */
+int
+drawmark(int x, unsigned int k)
+{
+	x = drawarrow(x, scheme[SchemeNorm], chipschemes[k], 1);
+	drw_setscheme(drw, chipschemes[k]);
+	x = drw_text(drw, x, statusvpad, TEXTW(chipkinds[k].icon), bh - 2 * statusvpad,
+		lrpad / 2, chipkinds[k].icon, 0);
+	return drawarrow(x, chipschemes[k], scheme[SchemeNorm], 1);
+}
+
+/* the unfocused windows of c's app as one entry in the bar's window list, as
+ * the BeOS Deskbar groups an app's windows (appgroups.diff): the app's icon,
+ * or its short name if it has none, and how many there are, then an agent's
+ * icon between arrows if one of them waits on you. From x and short of end;
+ * returns where it stops. */
+int
+drawgroup(Monitor *m, Client *c, int n, int x, int end)
+{
+	char label[48];
+	Client *d, *ic = NULL;
+	int iw, tw, waiting = 0;
+	unsigned int k;
+
+	for (d = m->clients; d; d = d->next)
+		if (ISVISIBLE(d) && d != m->sel && sameapp(d, c)) {
+			if (!ic && d->icon)
+				ic = d;
+			waiting |= haschip(d, "waiting");
+		}
+	if (ic)
+		snprintf(label, sizeof label, "\xc3\x97%d", n); /* the times sign */
+	else
+		snprintf(label, sizeof label, "%s \xc3\x97%d", c->appname, n);
+	iw = ic ? ic->icw + ICONSPACING : 0;
+	tw = TEXTW(label) - lrpad;
+	if (x + iw + tw > end)
+		return x;
+	drw_setscheme(drw, scheme[SchemeNorm]);
+	drw_text(drw, x, 0, iw + tw, bh, iw, label, 0);
+	if (ic)
+		drw_pic(drw, x, (bh - ic->ich) / 2, ic->icw, ic->ich, ic->icon);
+	x += iw + tw;
+	for (k = 0; k < LENGTH(chipkinds) && strcmp(chipkinds[k].kind, "waiting"); k++);
+	if (waiting && k < LENGTH(chipkinds) && x + 4 + TEXTW(chipkinds[k].icon) + 2 * arroww <= end)
+		x = drawmark(x + 4, k);
+	return x;
+}
