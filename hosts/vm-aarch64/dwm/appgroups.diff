+/* the app a window belongs to, for the bar's window list (appgroups.diff):
+ * its WM_CLASS instance, which tells Chrome's app windows from Chrome's, and
+ * a short name from its class, the last of the class's dotted parts up to a
+ * dash, in lower case: st-256color is st, org.wezfurlong.wezterm wezterm. A
+ * window without the hint is never grouped. */
+void
+updateapp(Client *c)
+{
+	XClassHint ch = { NULL, NULL };
+	const char *s;
+	size_t i;
+
+	XGetClassHint(dpy, c->win, &ch);
+	snprintf(c->app, sizeof c->app, "%s", ch.res_name ? ch.res_name : "");
+	s = ch.res_class ? ch.res_class : c->app;
+	s = strrchr(s, '.') ? strrchr(s, '.') + 1 : s;
+	for (i = 0; i + 1 < sizeof c->appname && s[i] && s[i] != '-'; i++)
+		c->appname[i] = tolower((unsigned char)s[i]);
+	c->appname[i] = '\0';
+	if (ch.res_class)
+		XFree(ch.res_class);
+	if (ch.res_name)
+		XFree(ch.res_name);
+}
