Bold text keeps its colour, as in Ghostty, whose bold-color is unset in
configs/ghostty/config. Stock st draws bold text in colours 0-7 with the
bright colours 8-15 instead, so on the Mac and in st the same output read
differently: ls's bold blue directories came out light blue in st.

--- a/x.c
+++ b/x.c
@@ -1415,10 +1415,6 @@ xdrawglyphfontspecs(const XftGlyphFontSpec *specs, Glyph base, int len, int x, i
 		bg = &dc.col[base.bg];
 	}
 
-	/* Change basic system colors [0-7] to bright system colors [8-15] */
-	if ((base.mode & ATTR_BOLD_FAINT) == ATTR_BOLD && BETWEEN(base.fg, 0, 7))
-		fg = &dc.col[base.fg + 8];
-
 	if (IS_SET(MODE_REVERSE)) {
 		if (fg == &dc.col[defaultfg]) {
 			fg = &dc.col[defaultbg];
